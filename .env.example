# Copy to .env and fill in. Env vars override config.yaml.
# Generate secrets with: openssl rand -hex 32
# With APP_SERVER_ENV=production the app refuses to start on missing/weak secrets
# or a localhost APP_FRONTEND_URL.
#
# Format rules (docker --env-file is stricter than godotenv):
#   KEY=value  -- no spaces around "=", no quotes, comments only on their own line

# ==================== SERVER ====================
# local | development | production
APP_SERVER_ENV=local
APP_SERVER_PORT=8080
# where the Vue app is served from (links in emails, referral links, default CORS origin)
APP_FRONTEND_URL=http://localhost:5173
# extra CORS origins on top of APP_FRONTEND_URL (always allowed), comma-separated
APP_CORS_ORIGINS=
# CIDRs of reverse proxies allowed to set X-Forwarded-For, comma-separated
APP_TRUSTED_PROXIES=
# path to the yaml config inside a container (optional)
# APP_CONFIG_PATH=/app/config.yaml
# public domain (VPS only); empty = localhost with Caddy's local certificate
#DOMAIN=
# ==================== POSTGRES ====================
# used when the app runs outside Docker (go run); docker compose builds its own DSN from POSTGRES_*
APP_POSTGRES_DSN=postgres://postgres:password@localhost:5432/app_db?sslmode=disable

# ==================== DOCKER COMPOSE ====================
# password goes into a URL: use hex (openssl rand -hex 24), no @ : / ? # characters
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=app_db
# host ports (bound to 127.0.0.1); 5433 so it does not clash with a local postgres on 5432
POSTGRES_HOST_PORT=5433
BACKEND_PORT=8080
FRONTEND_PORT=5173
# backend URL as the BROWSER sees it; baked into the frontend build
PUBLIC_API_URL=http://localhost:8080
# path to the frontend repo (build context)
FRONTEND_DIR=../referral-system-go

# ==================== SECRETS ====================
APP_JWT_SECRET_KEY=
APP_HMAC_SECRET_KEY=
APP_RECOVERY_CODE_HMAC_SECRET_KEY=

# ==================== CLOUDFLARE R2 ====================
APP_R2_ACCOUNT_ID=
APP_R2_ACCESS_ID_S3=
APP_R2_SECRET_ACCESS_KEY=
APP_R2_PUBLIC_BUCKET=media
APP_R2_PRIVATE_BUCKET=prmedia
APP_R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# ==================== STRIPE (v2, unused for now) ====================
# APP_STRIPE_SECRET_KEY=
# APP_STRIPE_WEBHOOK_SECRET=
