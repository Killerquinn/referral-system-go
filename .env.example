# Copy to .env and fill in. Env vars override config.yaml.
# Generate secrets with: openssl rand -hex 32
# With APP_SERVER_ENV=production the app refuses to start on missing/weak secrets
# or a localhost APP_FRONTEND_URL.

# ==================== SERVER ====================
APP_SERVER_ENV=local            # local | development | production
APP_SERVER_PORT=8080
# where the Vue app is served from (links in emails, referral links, default CORS origin)
APP_FRONTEND_URL=http://localhost:5173
# extra CORS origins, comma-separated (empty = only APP_FRONTEND_URL)
APP_CORS_ORIGINS=
# CIDRs of reverse proxies allowed to set X-Forwarded-For, comma-separated
APP_TRUSTED_PROXIES=
# path to the yaml config inside a container (optional)
# APP_CONFIG_PATH=/app/config.yaml

# ==================== POSTGRES ====================
APP_POSTGRES_DSN=postgres://postgres:password@localhost:5432/app_db?sslmode=disable

# ==================== SECRETS ====================
APP_JWT_SECRET_KEY=
APP_HMAC_SECRET_KEY=
APP_RECOVERY_CODE_HMAC_SECRET_KEY=

# ==================== CLOUDFLARE R2 ====================
APP_R2_ACCOUNT_ID=
APP_R2_ACCESS_ID_S3=
APP_R2_SECRET_ACCESS_KEY=
APP_R2_PUBLIC_BUCKET=media
APP_R2_PRIVATE_BUCKET=prmedia
APP_R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# ==================== STRIPE (v2, unused for now) ====================
# APP_STRIPE_SECRET_KEY=
# APP_STRIPE_WEBHOOK_SECRET=
